rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Expense documents carry an `uid` field; scope to the owner.
    match /transactions/{txnId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Budget documents carry an `uid` field; scope to the owner.
    match /budgets/{categoryId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // User settings are keyed by uid.
    match /settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCM device-token registry for push notifications.
    match /users/{uid}/devices/{token} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Written only by Cloud Functions (admin SDK bypasses these rules).
    match /users/{uid}/budget_alerts/{alertId} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ── Shared groups (household budgets / split expenses) ──────────────
    function signedIn() { return request.auth != null; }
    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }
    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupDoc(groupId).data.memberUids;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function membersMapTouchesOnly(uid) {
      return request.resource.data.members.diff(resource.data.members)
        .affectedKeys().hasOnly([uid]);
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;

      allow update: if signedIn() && (
        // A member edits settings (not membership, not ownership).
        (request.auth.uid in resource.data.memberUids
          && changed().hasOnly(['name', 'kind', 'monthlyBudget', 'inviteCode', 'updatedAt']))
        // A member leaves (removes only themselves).
        || (request.auth.uid in resource.data.memberUids
          && request.resource.data.memberUids
               == resource.data.memberUids.removeAll([request.auth.uid])
          && membersMapTouchesOnly(request.auth.uid)
          && changed().hasOnly(['memberUids', 'members', 'updatedAt']))
        // Someone joins with a valid, unexpired invite for this group.
        || (!(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids
               == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.memberUids.size() <= 20
          && membersMapTouchesOnly(request.auth.uid)
          && changed().hasOnly(['memberUids', 'members', 'lastJoinCode', 'updatedAt'])
          && exists(/databases/$(database)/documents/groupInvites/$(request.resource.data.lastJoinCode))
          && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.lastJoinCode)).data.groupId == groupId
          && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.lastJoinCode)).data.expiresAt > request.time)
      );

      // Only the last member can delete the group.
      allow delete: if signedIn() && resource.data.memberUids == [request.auth.uid];

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if isGroupMember(groupId)
          && (resource.data.createdBy == request.auth.uid
              || groupDoc(groupId).data.ownerUid == request.auth.uid);
      }

      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
      }
    }

    // Knowing the code is the capability to join: get, never list.
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow create: if isGroupMember(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isGroupMember(resource.data.groupId);
    }
  }
}
