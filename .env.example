# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values
# Get these from: https://console.firebase.google.com/ -> Project Settings
FIREBASE_API_KEY_ANDROID=YOUR_ANDROID_API_KEY_HERE
FIREBASE_APP_ID_ANDROID=YOUR_ANDROID_APP_ID_HERE
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET_HERE
FIREBASE_API_KEY_IOS=YOUR_IOS_API_KEY_HERE
FIREBASE_APP_ID_IOS=YOUR_IOS_APP_ID_HERE
FIREBASE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
FIREBASE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
FIREBASE_IOS_BUNDLE_ID=com.yourcompany.yourapp